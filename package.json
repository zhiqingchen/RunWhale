{
  "name": "runwhale",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter '!@runwhale/node-runtime' -r --if-present test",
    "test:node-runtime": "pnpm --filter @runwhale/node-runtime test",
    "check": "pnpm run test:secrets && pnpm run typecheck && pnpm run test",
    "test:secrets": "node --test scripts/check-no-secrets.test.mjs",
    "mobile": "pnpm --filter @runwhale/mobile start:desktop",
    "mobile:metro:alt": "pnpm --filter @runwhale/mobile start:desktop:alt",
    "mobile:android": "pnpm --filter @runwhale/mobile android",
    "mobile:ios": "pnpm --filter @runwhale/mobile ios",
    "mobile:ios:simulator": "bash scripts/install-ios-simulator.sh",
    "runtime:bundle": "bash native/node-host/scripts/build-module-store.sh && pnpm --filter @runwhale/node-runtime bundle:mobile",
    "native-modules:verify": "node scripts/verify-expo-native-modules.mjs",
    "upstreams:verify": "node scripts/verify-upstreams.mjs",
    "secrets:check": "node scripts/check-no-secrets.mjs",
    "release:validate": "node scripts/validate-release-version.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
