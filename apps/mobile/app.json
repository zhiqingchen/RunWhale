{
  "expo": {
    "name": "RunWhale",
    "slug": "runwhale",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "runwhale-community",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/runwhale-icon.png",
    "ios": {
      "icon": "./assets/images/runwhale-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "app.runwhale.community",
      "deploymentTarget": "16.4",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)app.runwhale.community"
        ],
        "com.apple.developer.associated-domains": [
          "applinks:share.runwhale.dev"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": ["processing"],
        "BGTaskSchedulerPermittedIdentifiers": ["app.runwhale.community.agent.*"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.runwhale.community",
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "minSdkVersion": 24,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/runwhale-adaptive-foreground-safe.png",
        "backgroundColor": "#F5F8FF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "share.runwhale.dev",
              "pathPrefix": "/g/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RunWhale uses the microphone to test audio recording in projects you run in Preview, such as a voice recorder.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RunWhale uses the camera to take photos for Agent attachments and to test camera features in projects you run in Preview."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "RunWhale uses device motion to test motion-responsive features in projects you run in Preview, such as tilt controls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RunWhale accesses photos and videos when you test media selection in Preview. Photos you select as Agent attachments are sent with your message.",
          "cameraPermission": "RunWhale uses the camera to take photos for Agent attachments and to test camera features in projects you run in Preview."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RunWhale uses your location while the app is in use to test location features in Preview, such as showing your position on a map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "RunWhale uses device motion to test motion-responsive features in projects you run in Preview, such as tilt controls."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "RunWhale uses your location while the app is in use to test location features in Preview, such as showing your position on a map."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "RunWhale accesses photos and videos when you test media selection in Preview. Photos you select as Agent attachments are sent with your message.",
          "savePhotosPermission": "RunWhale saves photos and videos to your library when you test media export in Preview, such as saving an image created by your project.",
          "granularPermissions": ["photo", "video", "audio"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/runwhale-splash-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9FF",
          "dark": {
            "image": "./assets/images/runwhale-splash-mark.png",
            "backgroundColor": "#07182A"
          }
        }
      ],
      "./plugins/with-node-ndk",
      "./plugins/with-ios-runtime-dependencies",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
